rules_version = '2';

// healthtool の Firestore セキュリティルール。
//
// 原則: 健康データは本人以外に一切見せない。ユーザー間の共有機能は現時点で存在しないため、
// 「uid が一致する場合のみ」以外の読み取り経路を作らない。
// LLM の評価結果 (insights) はサーバーが Admin SDK で書く。クライアントからの書き込みは
// 常に拒否し、プロンプト由来の内容をクライアントが偽装できないようにする。

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // daily ドキュメントは ID が日付。ID と中身の date がずれると集計が壊れるので書き込み時に弾く。
    function dailyIsConsistent(date) {
      let d = request.resource.data;
      return d.date == date
          && d.schemaVersion is int
          && d.tz is string
          && d.coverage is map;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      // 退会時のカスケード削除は Functions 側で行う。クライアントには消させない。
      allow delete: if false;

      match /daily/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && dailyIsConsistent(date);
        allow delete: if isOwner(uid);

        // 5分ビンに間引いた心拍などの日内データ。
        match /intraday/{kind} {
          allow read, write: if isOwner(uid);
        }
      }

      match /sleepSessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      match /workouts/{workoutId} {
        allow read, write: if isOwner(uid);
      }

      // LLM の評価結果。読むのは本人だけ、書けるのはサーバーだけ。
      match /insights/{insightId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // 上記にマッチしないパスはすべて拒否。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
