{
  "name": "@healthtool/schema",
  "version": "0.1.0",
  "private": true,
  "description": "healthtool の正準スキーマ。JSON Schema を唯一の正とし、TypeScript 型と Dart クラスを生成する。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "gen": "node scripts/gen-ts.mjs && node scripts/gen-dart.mjs",
    "gen:ts": "node scripts/gen-ts.mjs",
    "gen:dart": "node scripts/gen-dart.mjs",
    "build": "npm run gen:ts && tsc -p tsconfig.json",
    "clean": "rm -rf dist src/generated"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "quicktype": "^23.2.6",
    "typescript": "^5.9.2"
  }
}
