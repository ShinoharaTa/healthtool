{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healthtool.app/schemas/daily.schema.json",
  "title": "DailySummary",
  "description": "users/{uid}/daily/{yyyy-MM-dd} の1ドキュメント。ウェアラブルから取得した1日分の集約値。取得できなかった指標は必ず null になる（欠損と 0 を区別する）。",
  "type": "object",
  "required": ["schemaVersion", "date", "tz", "sources", "coverage", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "description": "このドキュメントの構造バージョン。破壊的変更時にインクリメントする。",
      "const": 1
    },
    "date": {
      "type": "string",
      "description": "ローカルタイムゾーンでの暦日 (YYYY-MM-DD)。ドキュメント ID と一致する。",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tz": {
      "type": "string",
      "description": "date を切り出したときの IANA タイムゾーン名。例: Asia/Tokyo",
      "examples": ["Asia/Tokyo"]
    },
    "activity": {
      "description": "活動量。",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "steps": { "type": ["integer", "null"], "minimum": 0 },
        "distanceM": { "type": ["number", "null"], "minimum": 0 },
        "activeKcal": { "type": ["number", "null"], "minimum": 0 },
        "totalKcal": { "type": ["number", "null"], "minimum": 0 },
        "floors": { "type": ["number", "null"], "minimum": 0 },
        "exerciseMin": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "hr": {
      "description": "心拍。restingBpm はデバイス算出の安静時心拍、無ければ null。",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "restingBpm": { "type": ["number", "null"], "minimum": 20, "maximum": 220 },
        "avgBpm": { "type": ["number", "null"], "minimum": 20, "maximum": 220 },
        "minBpm": { "type": ["number", "null"], "minimum": 20, "maximum": 220 },
        "maxBpm": { "type": ["number", "null"], "minimum": 20, "maximum": 250 },
        "sampleCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "hrv": {
      "description": "心拍変動。Mi Fitness が Health Connect に書かない可能性が高く、null が通常。",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "sdnnMs": { "type": ["number", "null"], "minimum": 0 },
        "rmssdMs": { "type": ["number", "null"], "minimum": 0 },
        "sampleCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "spo2": {
      "description": "血中酸素飽和度。",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "avgPct": { "type": ["number", "null"], "minimum": 50, "maximum": 100 },
        "minPct": { "type": ["number", "null"], "minimum": 50, "maximum": 100 },
        "sampleCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "respiratory": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "avgRpm": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "sleep": {
      "description": "その暦日に「起床した」睡眠。前日夜に就寝した分はこの日に集計する（起床日基準）。",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "sessionIds": {
          "type": "array",
          "description": "この日に集計した sleepSessions ドキュメントの ID。",
          "items": { "type": "string" }
        },
        "startAt": { "type": ["string", "null"], "format": "date-time" },
        "endAt": { "type": ["string", "null"], "format": "date-time" },
        "midSleepAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "就寝と起床の中点。睡眠規則性の指標に使う。"
        },
        "inBedMin": { "type": ["number", "null"], "minimum": 0 },
        "totalMin": { "type": ["number", "null"], "minimum": 0 },
        "deepMin": { "type": ["number", "null"], "minimum": 0 },
        "lightMin": { "type": ["number", "null"], "minimum": 0 },
        "remMin": { "type": ["number", "null"], "minimum": 0 },
        "awakeMin": { "type": ["number", "null"], "minimum": 0 },
        "unknownMin": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "睡眠とは判定されたがステージ不明の時間。Health Connect の STAGE_TYPE_SLEEPING 相当。"
        },
        "efficiencyPct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "totalMin / inBedMin * 100"
        }
      }
    },
    "workouts": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": ["integer", "null"], "minimum": 0 },
        "totalMin": { "type": ["number", "null"], "minimum": 0 },
        "totalKcal": { "type": ["number", "null"], "minimum": 0 },
        "byType": {
          "type": ["object", "null"],
          "description": "ワークアウト種別 → 実施回数と合計分数。",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": { "type": "integer", "minimum": 0 },
              "minutes": { "type": "number", "minimum": 0 }
            },
            "required": ["count", "minutes"]
          }
        }
      }
    },
    "body": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "weightKg": { "type": ["number", "null"], "minimum": 0 },
        "bodyFatPct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "bmi": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "vitals": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "bodyTempC": { "type": ["number", "null"] },
        "bloodPressureSys": { "type": ["number", "null"], "minimum": 0 },
        "bloodPressureDia": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "nutrition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "waterMl": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "sources": {
      "type": "array",
      "description": "この日のデータを書き込んだアプリのパッケージ名。例: com.mi.health",
      "items": { "type": "string" }
    },
    "coverage": {
      "description": "計測がどれだけ埋まっているか。LLM に「何が分かっていないか」を渡すために必須。",
      "type": "object",
      "required": ["hrCoveredMin", "hasSleep", "hasSteps", "wornHours"],
      "additionalProperties": false,
      "properties": {
        "hrCoveredMin": {
          "type": "number",
          "minimum": 0,
          "description": "心拍サンプルが存在した時間の概算（分）。装着時間の代理指標。"
        },
        "wornHours": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "description": "hrCoveredMin から算出した推定装着時間。"
        },
        "hasSleep": { "type": "boolean" },
        "hasSteps": { "type": "boolean" }
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "このドキュメントを最後に書いた時刻 (ISO 8601)。"
    }
  }
}
