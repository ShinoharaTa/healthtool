{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://healthtool.app/schemas/insight.schema.json",
  "title": "Insight",
  "description": "users/{uid}/insights/{id} — LLM による評価結果。body 部分は Gemini の responseSchema としてそのまま使うため、LLM に生成させないメタ情報とは分離してある。",
  "type": "object",
  "required": ["schemaVersion", "id", "period", "startDate", "endDate", "model", "inputHash", "body", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string" },
    "period": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
    "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "model": {
      "type": "string",
      "description": "生成に使ったモデル ID。後から結果を比較できるよう必ず記録する。"
    },
    "inputHash": {
      "type": "string",
      "description": "LLM に渡した入力 JSON の SHA-256。同一ハッシュならキャッシュを返して再生成しない。"
    },
    "verification": {
      "description": "サーバー側で行った幻覚チェックの結果。",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["checkedClaims", "unverifiedClaims"],
      "properties": {
        "checkedClaims": { "type": "integer", "minimum": 0 },
        "unverifiedClaims": {
          "type": "array",
          "description": "evidence の数値が入力データに存在しなかった finding のインデックスと内容。",
          "items": {
            "type": "object",
            "required": ["findingIndex", "reason"],
            "additionalProperties": false,
            "properties": {
              "findingIndex": { "type": "integer" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "body": { "$ref": "#/definitions/InsightBody" }
  },
  "definitions": {
    "InsightBody": {
      "title": "InsightBody",
      "description": "Gemini に structured output で生成させる本体。このスキーマがそのまま responseSchema になる。",
      "type": "object",
      "required": ["headline", "scores", "findings", "recommendations", "watchouts", "dataGaps"],
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string",
          "description": "この期間を一文で言い切った見出し。60文字以内。断定を避けた曖昧な表現にはしない。"
        },
        "scores": {
          "type": "object",
          "required": ["sleep", "activity", "recovery", "overall"],
          "additionalProperties": false,
          "description": "0-100 の評価。絶対的な健康度ではなく、この人自身の直近ベースラインに対する相対評価。",
          "properties": {
            "sleep": { "type": "integer", "minimum": 0, "maximum": 100 },
            "activity": { "type": "integer", "minimum": 0, "maximum": 100 },
            "recovery": { "type": "integer", "minimum": 0, "maximum": 100 },
            "overall": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "description": "データから読み取れた事実。推測ではなく数値の裏付けがあるものだけ。",
          "items": {
            "type": "object",
            "required": ["metric", "observation", "evidence", "confidence"],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string",
                "description": "対象指標のキー。入力 JSON に実在するキー名を使う。例: sleep.totalMin, hr.restingBpm"
              },
              "observation": {
                "type": "string",
                "description": "何が起きているかの説明。"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "description": "observation の根拠となる実際の数値。入力データに存在する値だけを引用すること。サーバーが突合検証する。",
                "items": {
                  "type": "object",
                  "required": ["label", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "その数値が何か。例: 今週の平均睡眠時間(分)"
                    },
                    "value": { "type": "number" },
                    "unit": { "type": ["string", "null"] },
                    "date": {
                      "type": ["string", "null"],
                      "description": "特定日の値ならその日付 (YYYY-MM-DD)。期間集計値なら null。"
                    }
                  }
                }
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"],
                "description": "データ量と欠損率を踏まえた確信度。装着時間が短い日が多ければ low にする。"
              }
            }
          }
        },
        "recommendations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "明日から実行できる具体的な行動。一般論ではなくこの人のデータに紐付いたもの。",
          "items": {
            "type": "object",
            "required": ["action", "rationale", "effort"],
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string",
                "description": "実行する行動。時刻や分数など具体的な数字を含める。"
              },
              "rationale": {
                "type": "string",
                "description": "なぜそれを勧めるか。どの finding に基づくか。"
              },
              "effort": { "type": "string", "enum": ["low", "medium", "high"] }
            }
          }
        },
        "watchouts": {
          "type": "array",
          "maxItems": 3,
          "description": "医療的に注意すべき兆候。該当が無ければ空配列にする。無理に埋めない。",
          "items": {
            "type": "object",
            "required": ["signal", "suggestion"],
            "additionalProperties": false,
            "properties": {
              "signal": { "type": "string", "description": "観測された懸念事項と該当する数値。" },
              "suggestion": {
                "type": "string",
                "description": "取るべき行動。診断や治療法ではなく、受診の検討を促す形にする。"
              }
            }
          }
        },
        "dataGaps": {
          "type": "array",
          "description": "評価の妨げになった欠損。例: 装着時間が短い日、取得できていない指標。",
          "items": { "type": "string" }
        }
      }
    }
  }
}
